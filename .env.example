# NiyamSetu Environment Configuration Template
# Copy this file to .env and replace placeholder values for local development.
# DO NOT commit real passwords, secrets, or .env files to Git.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="NiyamSetu API"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-your-local-env
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL running directly on local machine)
# Note: Use a dedicated database user and the target database 'niyamsetu_dev'.
# Example with psycopg: postgresql+psycopg://niyamsetu_user:password@localhost:5432/niyamsetu_dev
DATABASE_URL=postgresql+psycopg://niyamsetu_user:replace_with_local_password@localhost:5432/niyamsetu_dev

# Cross-Origin Resource Sharing (Local Frontend)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local File Storage
STORAGE_LOCAL_DIR=./uploads

# Seed Development Credentials (Used only during explicit local db seed execution)
SEED_ADMIN_PASSWORD=ChangeMeDev123!
SEED_DEFAULT_USER_PASSWORD=ChangeMeDev123!

# Frontend Environment Variables (for frontend/.env or Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
